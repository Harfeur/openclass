<!doctype html>
<html lang="fr">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Open Class</title>
    <script src="https://cdn.jsdelivr.net/npm/lemonadejs/dist/lemonade.min.js"></script>
    <script src="/vendor/calendarjs/index.js"></script>
    <link rel="stylesheet" href="/vendor/calendarjs/style.css" />
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/stylesheets/index.css" />
</head>

<body>

    <header>
        <nav class="navbar navbar-light bg-light">
            <a class="navbar-brand" href="http://localhost:3000/try">
                <img src="images/openclass-logo.png" width="30" height="30" class="d-inline-block align-top" alt="">
                OpenClass
            </a>
            <button id="inscription" type="button" class="btn btn-success" data-bs-toggle="modal"
                data-bs-target="#exampleModal">S'inscrire</button>
            <!-- <button id="inscription" type="button" class="btn btn-primary" data-bs-toggle="modal"
                data-bs-target="#exampleModal">
                S'inscrire
            </button> -->
        </nav>
    </header>


    <div id="parent">
        <div id='schedule' style="height: 100%;"></div>

    </div>





    <!-- Button trigger modal -->




    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="exampleModalLabel">Je veux être visité</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div id="alertes" class="px-3 pt-2">

                </div>

                <form id="form_inscr" method="post">

                    <div class="modal-body">

                        <div class="mb-3">
                            <label for="matieres" class="form-label">Matière <span class="req">*</span></label>
                            <select id="matieres" class="form-select" required>
                                <option value="" selected disabled hidden>Choisisez</option>
                                <% for(var i=0; i<data_matiere.length ; i++) {%>
                                    <option value=<%=data_matiere[i].id %> >
                                        <%=data_matiere[i].matiere %>
                                    </option>
                                    <% } %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="groupes" class="form-label">Groupe <span class="req">*</span></label>
                            <select id="groupes" class="form-select" required>
                                <option value="" selected disabled hidden>Choisisez</option>
                                <% for(var i=0; i<data_groupes.length; i++) {%>
                                    <option value=<%=data_groupes[i].id %> >
                                        <%=data_groupes[i].groupe %>
                                    </option>
                                    <% } %>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="date" class="form-label">Date <span class="req">*</span></label>
                            <input type="date" class="form-control" id="date" name="date" required>

                        </div>
                        <div class="mb-3">
                            <label for="heureDebut" class="form-label">Heure Debut <span class="req">*</span></label>
                            <input type="time" class="form-control" id="heureDebut" name="heureDebut" required>
                        </div>
                        <div class="mb-3">
                            <label for="heureFin" class="form-label">Heure Fin <span class="req">*</span></label>
                            <input type="time" class="form-control" id="heureFin" name="heureFin" required>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="radioDefault" id="reguliere"
                                onchange="reguilereE()">
                            <label class="form-check-label" for="reguliere">
                                Régulièrement
                            </label>
                        </div>

                        <div id="reguliereOptions">
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="semaineA">
                                <label class="form-check-label" for="semaineA">Semaine A</label>
                            </div>
                            <div class="mb-3 form-check">
                                <input type="checkbox" class="form-check-input" id="semaineB">
                                <label class="form-check-label" for="semaineB">Semaine B</label>
                            </div>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="radioDefault" id="uneSeeulFois"
                                onchange="reguilereE()">
                            <label class="form-check-label" for="uneSeeulFois">
                                Une seule fois
                            </label>
                        </div>


                        <div class="mb-3">
                            <label for="nom" class="form-label">Votre Nom & Prénom <span class="req">*</span></label>
                            <input type="name" class="form-control" id="nom" aria-describedby="emailHelp" required>
                        </div>
                        <div class="mb-3">
                            <label for="courriel" class="form-label">Votre E-Mail <span class="req">*</span></label>
                            <input type="email" class="form-control" id="courriel" aria-describedby="emailHelp"
                                required>
                        </div>


                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button id="nouveau" type="submit" class="btn btn-primary">Inscrire</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
    <!-- Modal Détails Evénement -->
    <div class="modal fade" id="eventDetailsModal" tabindex="-1" aria-labelledby="eventDetailsModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="eventDetailsModalLabel">Détails du cours</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2"><strong>Matière :</strong> <span id="eventMatiere"></span></p>
                    <p class="mb-2"><strong>Groupe :</strong> <span id="eventGroupe"></span></p>
                    <p class="mb-2"><strong>Enseignant :</strong> <span id="eventProf"></span></p>
                    <p class="mb-2"><strong>Courriel :</strong> <span id="eventCourriel"></span></p>
                    <p class="mb-2"><strong>Date :</strong> <span id="eventDate"></span></p>
                    <p class="mb-2"><strong>Horaires :</strong> <span id="eventHoraires"></span></p>
                    <p class="mb-2"><strong>Périodicité :</strong> <span id="eventFrequence"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                </div>
            </div>
        </div>
    </div>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/index.js"></script>


    <footer>
        <a href="#">OpenClass</a> © 2026 by <a href="#">Daniel Hasan</a> is licensed
        under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a><img
            src="https://mirrors.creativecommons.org/presskit/icons/cc.svg" alt=""
            style="max-width: 1em;max-height:1em;margin-left: .2em;"><img
            src="https://mirrors.creativecommons.org/presskit/icons/by.svg" alt=""
            style="max-width: 1em;max-height:1em;margin-left: .2em;"><img
            src="https://mirrors.creativecommons.org/presskit/icons/nc.svg" alt=""
            style="max-width: 1em;max-height:1em;margin-left: .2em;"><img
            src="https://mirrors.creativecommons.org/presskit/icons/sa.svg" alt=""
            style="max-width: 1em;max-height:1em;margin-left: .2em;">
    </footer>

    <script>
        const { Schedule } = calendarjs;
        const calender = '<%- JSON.stringify(data_calendrier) %>';
        const obj = JSON.parse(calender);

        function showEventDetails(eventData) {
            if (!eventData) return;
            document.getElementById('eventMatiere').textContent = eventData.matiere || '';
            document.getElementById('eventGroupe').textContent = eventData.groupe || '';
            document.getElementById('eventProf').textContent = eventData.prof || '';
            document.getElementById('eventCourriel').textContent = eventData.courriel || '';
            document.getElementById('eventDate').textContent = eventData.date || '';
            document.getElementById('eventHoraires').textContent = `${eventData.start || eventData.debut || ''} - ${eventData.end || eventData.fin || ''}`;

            let frequence = 'Une seule fois';
            const isSemaineA = eventData.semaine_a === 1 || eventData.semaine_a === '1' || eventData.semaine_a === true || eventData.semaine_a === 'true';
            const isSemaineB = eventData.semaine_b === 1 || eventData.semaine_b === '1' || eventData.semaine_b === true || eventData.semaine_b === 'true';

            if (isSemaineA && isSemaineB) {
                frequence = 'Régulier (Toutes les semaines)';
            } else if (isSemaineA) {
                frequence = 'Régulier (Semaine A)';
            } else if (isSemaineB) {
                frequence = 'Régulier (Semaine B)';
            }
            document.getElementById('eventFrequence').textContent = frequence;

            const eventModalEl = document.getElementById('eventDetailsModal');
            const modal = bootstrap.Modal.getInstance(eventModalEl) || bootstrap.Modal.getOrCreateInstance(eventModalEl);
            modal.show();
        }

        const arr = [];
        for (let index = 0; index < obj.length; index++) {
            const element = obj[index];
            const dateObj = new Date(element.date + 'T12:00:00');
            arr.push({
                guid: String(element.id || index),
                title: `${element.matiere} (${element.groupe})`,
                description: element.prof,
                weekday: dateObj.getDay(),
                start: element.debut,
                end: element.fin,
                color: '#3498db',
                matiere: element.matiere,
                groupe: element.groupe,
                prof: element.prof,
                courriel: element.courriel,
                date: element.date,
                debut: element.debut,
                fin: element.fin,
                semaine_a: element.semaine_a,
                semaine_b: element.semaine_b
            });
        }

        const schedule = Schedule(document.getElementById('schedule'), {
            type: 'weekdays',
            weekly: true,
            validRange: ['08:00', '18:00'],
            readOnlyRange: ['08:00', '18:00'],
            overlap: true,
            data: arr,
            ondblclick: function(self, event) {
                showEventDetails(event);
            },
            onedition: function(self, event) {
                showEventDetails(event);
            }
        });

        document.getElementById('schedule').addEventListener('click', function (e) {
            const item = e.target.closest('.lm-schedule-item');
            if (!item) return;
            const eventData = item.event || obj.find((el, idx) => String(el.id) === String(item.id) || String(idx) === String(item.id));
            if (eventData) {
                showEventDetails(eventData);
            }
        });
    </script>
</body>

</html>